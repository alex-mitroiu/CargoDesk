        <mxCell id="eFsAr" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0E7C86;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="nFirstSent" target="nAr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ PHASE 6 : RESOLUTION ============ -->
        <mxCell id="p6" value="PHASE 6 &#183; RESOLUTION &#8212; &lt;font color=&quot;#56666B&quot; style=&quot;font-weight:normal&quot;&gt;OR: pick one path (or neither, yet)&lt;/font&gt;" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#142229;" vertex="1" parent="1">
