          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="noteNeither" value="(ages normally)" style="text;html=1;align=center;fontSize=10;fontStyle=2;fontColor=#56666B;" vertex="1" parent="1">
