        <mxCell id="rReport3" value="&lt;b&gt;Credit Overrides Queue&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3B5E86&quot; style=&quot;font-family:monospace;font-size:10px&quot;&gt;&#9861; credit_overrides&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-size:10px&quot;&gt;every blocked shipment, visible fleet-wide to admin/operator; only the shipment's own lane trade_manager can act on it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2CE;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
