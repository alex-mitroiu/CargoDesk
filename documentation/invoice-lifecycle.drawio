        <mxCell id="eE_no" value="NO" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#A97600;strokeWidth=2;fontColor=#A97600;fontStyle=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dE" target="rSTOP2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Parallel watch box -->
        <mxCell id="rParallel" value="PARALLEL WATCH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#56666B;dashed=1;fontSize=10;fontStyle=1;verticalAlign=top;align=center;fontColor=#56666B;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1270" y="420" width="230" height="345" as="geometry" />
        </mxCell>
        <mxCell id="rMonitor" value="&lt;b&gt;Invoice Deadline Monitor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3B5E86&quot; style=&quot;font-family:monospace;font-size:9.5px&quot;&gt;&#9861; shipment_milestones (delivered)&lt;br&gt;&#9861; customers.invoice_deadline_days&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-size:9.5px&quot;&gt;soft/informational, never a block&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2CE;fontSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1290" y="460" width="190" height="110" as="geometry" />
