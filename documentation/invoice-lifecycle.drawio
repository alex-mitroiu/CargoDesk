        <mxCell id="eConfirmOr" style="edgeStyle=none;html=1;endArrow=block;strokeColor=#0E7C86;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="nConfirm" target="orBadge2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rEmail" value="&lt;b&gt;Email&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3B5E86&quot; style=&quot;font-family:monospace;font-size:10px&quot;&gt;&#9861; office_mail_settings&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-size:10px&quot;&gt;EMO office only, no fallback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2CE;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1900" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rEdi" value="&lt;b&gt;EDI&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3B5E86&quot; style=&quot;font-family:monospace;font-size:10px&quot;&gt;document-distribution svc &#183; :3002&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-size:10px&quot;&gt;formal transmittal + SHA-256 checksum&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2CE;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="340" y="1900" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rWebhook" value="&lt;b&gt;Webhook&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3B5E86&quot; style=&quot;font-family:monospace;font-size:10px&quot;&gt;document-distribution svc &#183; :3002&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-size:10px&quot;&gt;HMAC-signed outbound HTTPS POST&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2CE;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="1900" width="280" height="110" as="geometry" />
        </mxCell>
        <mxCell id="eOR2_email" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0E7C86;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orBadge2" target="rEmail">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eOR2_edi" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0E7C86;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orBadge2" target="rEdi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eOR2_web" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0E7C86;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orBadge2" target="rWebhook">
