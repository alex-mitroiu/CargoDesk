          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rMarkPaid" value="&lt;b&gt;Mark as Paid&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3B5E86&quot; style=&quot;font-family:monospace;font-size:10px&quot;&gt;paidAt + paidAmount both required&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-size:10px&quot;&gt;(never auto-defaulted) &#183; gated admin / operator&lt;br&gt;reduces outstandingAr &#8212; aging clock NOT reset&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B5E86&quot; style=&quot;font-family:monospace;font-size:9.5px&quot;&gt;&#9861; paid_at / paid_amount / transaction_id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2CE;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="2520" width="360" height="140" as="geometry" />
