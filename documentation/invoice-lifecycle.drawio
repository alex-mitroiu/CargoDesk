        <mxCell id="rBell" value="&#128276; Notification Bell&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-size:10px&quot;&gt;&amp;quot;Invoicing Overdue&amp;quot; section&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2CE;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1290" y="600" width="190" height="80" as="geometry" />
