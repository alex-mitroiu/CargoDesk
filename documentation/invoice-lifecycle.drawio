          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="noteWatch" value="watches for a MISSING invoice &#8212; not a step that follows this flow" style="text;html=1;align=center;fontSize=9.5;fontStyle=2;fontColor=#56666B;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1290" y="685" width="190" height="60" as="geometry" />
        </mxCell>

