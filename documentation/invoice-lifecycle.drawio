<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram name="Invoice Lifecycle" id="invoiceLifecycle">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="3220" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ PHASE 1 : CHARGE ACCUMULATION ============ -->
        <mxCell id="p1" value="PHASE 1 &#183; CHARGE ACCUMULATION" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#142229;" vertex="1" parent="1">
          <mxGeometry x="40" y="35" width="400" height="24" as="geometry" />
        </mxCell>

        <mxCell id="nA" value="&lt;b&gt;Cost lines accrue on the shipment&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3B5E86&quot; style=&quot;font-family:monospace;font-size:10px&quot;&gt;&#9861; shipment_cost_lines (BUY / SELL)&lt;br&gt;&#9861; contract_rates &#183; quote_lines &#183; charge_code_definitions&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E7C86;strokeWidth=2.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="260" y="95" width="440" height="110" as="geometry" />
        </mxCell>

        <mxCell id="nB" value="&lt;b&gt;Operator clicks Generate Invoice&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-size:11px&quot;&gt;consolidated (FR01) or per-container (FR02)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B5E86&quot; style=&quot;font-family:monospace;font-size:10px&quot;&gt;Invoice Entry page &#8594; POST .../documents/generate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2CE;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="260" y="255" width="440" height="90" as="geometry" />
        </mxCell>

        <mxCell id="eAB" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0E7C86;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="nA" target="nB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ PHASE 2 : CREDIT GATE ============ -->
        <mxCell id="p2" value="PHASE 2 &#183; CREDIT GATE &#8212; &lt;font color=&quot;#56666B&quot; style=&quot;font-weight:normal&quot;&gt;AND: every check below must clear before a PDF is ever rendered&lt;/font&gt;" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#142229;" vertex="1" parent="1">
          <mxGeometry x="40" y="405" width="900" height="24" as="geometry" />
