        <!-- ============ PHASE 5 : LIVE IN THE LEDGER ============ -->
        <mxCell id="p5" value="PHASE 5 &#183; LIVE IN THE LEDGER" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#142229;" vertex="1" parent="1">
