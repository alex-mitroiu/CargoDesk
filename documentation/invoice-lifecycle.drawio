        <mxCell id="nConfirm" value="&lt;b&gt;Operator clicks Confirm&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3B5E86&quot; style=&quot;font-family:monospace;font-size:10.5px&quot;&gt;status &#8594; confirmed &#183; confirmed_at stamped&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-size:10.5px&quot;&gt;(this date anchors AR aging) &#183; invoice_owner_id defaulted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2CE;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="260" y="1650" width="440" height="110" as="geometry" />
