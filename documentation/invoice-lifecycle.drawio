        </mxCell>
        <mxCell id="eC_yes" value="YES" style="edgeStyle=none;html=1;endArrow=block;strokeColor=#B23A2E;strokeWidth=2;fontColor=#B23A2E;fontStyle=1;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dC" target="rSTOP1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="dD" value="Projected AR &gt;&lt;br&gt;credit_limit?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E2E9E7;strokeColor=#0E7C86;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="610" width="380" height="140" as="geometry" />
