        <mxCell id="rConsolidated" value="&lt;b&gt;Consolidated&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-size:11px&quot;&gt;FR01 &#8212; one invoice, every SELL line&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2CE;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="140" y="1060" width="320" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rPerContainer" value="&lt;b&gt;Per-container&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-size:11px&quot;&gt;FR02 &#8212; one invoice per container&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B5E86&quot; style=&quot;font-family:monospace;font-size:9.5px&quot;&gt;&#9861; charge_code_definitions auto-injects a fee line into every container missing one&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2CE;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="1060" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="eOR1_left" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0E7C86;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orBadge1" target="rConsolidated">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eOR1_right" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0E7C86;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orBadge1" target="rPerContainer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="mergeSplit" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0E7C86;strokeColor=#0E7C86;" vertex="1" parent="1">
