        <mxCell id="nFirstSent" value="&lt;b&gt;first_sent_at stamped&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-size:10.5px&quot;&gt;first channel to send wins &#8212; a resend never overwrites it&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2CE;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="260" y="2130" width="440" height="90" as="geometry" />
