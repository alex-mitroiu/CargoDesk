        <mxCell id="mergeAND" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0E7C86;strokeColor=#0E7C86;" vertex="1" parent="1">
          <mxGeometry x="474" y="894" width="12" height="12" as="geometry" />
        </mxCell>
        <mxCell id="noteMerge" value="both checks cleared" style="text;html=1;align=left;fontSize=10;fontStyle=2;fontColor=#56666B;" vertex="1" parent="1">
          <mxGeometry x="500" y="895" width="220" height="18" as="geometry" />
        </mxCell>
        <mxCell id="eD_no" value="NO" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#0E7C86;strokeWidth=2;fontColor=#0E7C86;fontStyle=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0.5;" edge="1" parent="1" source="dD" target="mergeAND">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eE_yes" value="YES" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#0E7C86;strokeWidth=2;fontColor=#0E7C86;fontStyle=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0.5;" edge="1" parent="1" source="dE" target="mergeAND">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rSTOP2" value="&lt;b&gt;&lt;font color=&quot;#A97600&quot;&gt;BLOCKED &#8212; needs approval&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-weight:normal;font-size:11px&quot;&gt;the shipment's own lane trade_manager&lt;br&gt;must approve &#8212; never admin/operator&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B5E86&quot; style=&quot;font-family:monospace;font-size:10px&quot;&gt;visible in the Credit Overrides queue&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF0D2;strokeColor=#A97600;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
