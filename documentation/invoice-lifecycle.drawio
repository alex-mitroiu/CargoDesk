        <mxCell id="eOr3_paid" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0E7C86;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orBadge3" target="rMarkPaid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rPaidEnd" value="&lt;b&gt;PAID&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-weight:normal;font-size:10.5px&quot;&gt;in full or in part&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#E1F1E7;strokeColor=#2E7D53;strokeWidth=2;fontColor=#2E7D53;fontSize=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="2740" width="280" height="80" as="geometry" />
