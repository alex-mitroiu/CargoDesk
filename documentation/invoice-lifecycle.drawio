        <mxCell id="ePaid" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2E7D53;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="rMarkPaid" target="rPaidEnd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rReverse" value="&lt;b&gt;Reverse&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0E7C86&quot; style=&quot;font-style:italic;font-size:10px&quot;&gt;gate (AND): status=confirmed AND not already reversed&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B5E86&quot; style=&quot;font-family:monospace;font-size:9.5px&quot;&gt;&#9861; new shipment_cost_lines rows &#8212; type SELL, amount negated, source=reversal, already posted&lt;br&gt;&#9861; original shipment_documents &#8594; status = voided&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-size:10px&quot;&gt;both writes are one atomic transaction&lt;br&gt;then generates a CN01 Credit / Debit Note &#8593;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2CE;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="580" y="2520" width="360" height="160" as="geometry" />
