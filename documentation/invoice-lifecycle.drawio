          <mxGeometry x="183" y="653" width="34" height="34" as="geometry" />
        </mxCell>
        <mxCell id="andBracket" style="edgeStyle=none;html=1;endArrow=none;startArrow=none;strokeColor=#0E7C86;strokeWidth=1.5;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="235" y="440" />
              <mxPoint x="222" y="440" />
              <mxPoint x="222" y="900" />
              <mxPoint x="235" y="900" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="noteC" value="&#9861; customers.credit_hold (+ contracts.named_account_id)" style="text;html=1;align=left;fontSize=10;fontColor=#3B5E86;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="560" y="362" width="420" height="18" as="geometry" />
        </mxCell>

        <mxCell id="dC" value="On credit_hold?&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-weight:normal;font-size:10px&quot;&gt;shipper / consignee / principal / named account&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#E2E9E7;strokeColor=#0E7C86;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="420" width="380" height="140" as="geometry" />
        </mxCell>

        <mxCell id="rSTOP1" value="&lt;b&gt;&lt;font color=&quot;#B23A2E&quot;&gt;BLOCKED &#8212; HTTP 409&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-weight:normal;font-size:11px&quot;&gt;no override exists for a hold &#8212;&lt;br&gt;not even the lane trade_manager can bypass it&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B5E86&quot; style=&quot;font-family:monospace;font-size:10px&quot;&gt;resolve via Customer Profile &#8594; release hold&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7E4E1;strokeColor=#B23A2E;strokeWidth=1.5;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
