        <mxCell id="eC_no" value="NO" style="edgeStyle=none;html=1;endArrow=block;strokeColor=#0E7C86;strokeWidth=2;fontColor=#0E7C86;fontStyle=1;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dC" target="dD">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="noteD" value="&#9861; credit_limit vs AR" style="text;html=1;align=right;fontSize=10;fontColor=#3B5E86;fontFamily=monospace;" vertex="1" parent="1">
          <mxGeometry x="200" y="763" width="260" height="18" as="geometry" />
