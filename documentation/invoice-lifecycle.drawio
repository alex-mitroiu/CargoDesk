        </mxCell>

        <mxCell id="orBadge2" value="OR" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0E7C86;strokeColor=#0E7C86;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1">
