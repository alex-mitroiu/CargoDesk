        <mxCell id="orBadge1" value="OR" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0E7C86;strokeColor=#0E7C86;fontColor=#FFFFFF;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="461" y="959" width="38" height="38" as="geometry" />
        </mxCell>
        <mxCell id="eMergeOr1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0E7C86;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mergeAND" target="orBadge1">
          <mxGeometry relative="1" as="geometry" />
