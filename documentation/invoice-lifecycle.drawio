        </mxCell>
        <mxCell id="eCons_merge" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#0E7C86;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0.5;" edge="1" parent="1" source="rConsolidated" target="mergeSplit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ePer_merge" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#0E7C86;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0.5;" edge="1" parent="1" source="rPerContainer" target="mergeSplit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="nVat" value="&lt;b&gt;Compute VAT + subtotal per currency&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-size:11px&quot;&gt;capture the exact sourceCostLineIds invoiced&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#3B5E86&quot; style=&quot;font-family:monospace;font-size:10px&quot;&gt;&#9861; shipment_cost_lines (SELL lines, this invoice's scope)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2CE;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="260" y="1290" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="eMergeSplitVat" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0E7C86;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mergeSplit" target="nVat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="nSign" value="&lt;b&gt;Render &#8594; Sign &#8594; Store&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#3B5E86&quot; style=&quot;font-family:monospace;font-size:10.5px&quot;&gt;&#8594; PDF Render Service &#8212; Puppeteer, port 3003&lt;br&gt;&#8594; org_signing_certs &#8212; CAdES-detached PKCS#7 signature&lt;br&gt;&#8594; INSERT &#9861; shipment_documents, status = draft&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#56666B&quot; style=&quot;font-size:9.5px&quot;&gt;attempt logged first &#8212; durable even if rendering crashes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C7D2CE;fontSize=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="240" y="1450" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="eVatSign" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#0E7C86;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="nVat" target="nSign">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ PHASE 4 : CONFIRMATION & DISTRIBUTION ============ -->
        <mxCell id="p4" value="PHASE 4 &#183; CONFIRMATION &amp; DISTRIBUTION" style="text;html=1;align=left;fontSize=13;fontStyle=1;fontColor=#142229;" vertex="1" parent="1">
