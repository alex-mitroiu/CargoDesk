  },
  "item": [

    {
      "name": "Shipments",
      "item": [
        {
          "name": "List shipments",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/shipments" }
        },
        {
          "name": "Get shipment",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/shipments/SHP-XXXXXX" }
        },
        {
          "name": "Create shipment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/shipments",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"pol\": \"NLRTM\",\n  \"pod\": \"SGSIN\",\n  \"carrierCode\": \"MSCU\",\n  \"contractType\": \"Central Contract\",\n  \"status\": \"Active\",\n  \"etd\": \"2026-08-01\",\n  \"eta\": \"2026-08-25\"\n}" }
          }
        },
        {
          "name": "Update shipment",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/shipments/SHP-XXXXXX",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"Completed\",\n  \"blNumber\": \"MSCUABC123\"\n}" }
          }
        },
        {
          "name": "Delete shipment",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/shipments/SHP-XXXXXX" }
        },
        {
          "name": "Get shipment events",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/shipments/SHP-XXXXXX/events" }
        },
        {
          "name": "Get shipment status log",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/shipments/SHP-XXXXXX/status-log" }
        },
        {
          "name": "Get compliance hits",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/shipments/compliance-hits" }
        }
      ]
    },

