{
  "info": {
    "name": "CargoDesk API v0.20.0",
    "_postman_id": "cargodesk-v0-20-0",
    "description": "Full REST API for CargoDesk freight management system. Import CargoDesk.postman_environment.json and set the active environment to use {{baseUrl}}.",
