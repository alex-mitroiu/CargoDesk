# Copy to .env and fill in real values before deploying. Every one of these has an insecure
# dev-default fallback baked into the code (so local `npm run dev` works with zero setup) —
# each fallback logs a console warning naming itself, deliberately, so it's impossible to miss
# in server logs if a real deployment is accidentally still running on the dev defaults.
#
# Running via `docker compose` (docker-compose.yml)? The 3 secrets below are set via
# docker-secrets/*.txt files instead (Compose's native file-based secrets mechanism — see
# docker-compose.yml's own header comment) and don't need to be in this file at all. Set them
# here only for `npm run dev`, a bare `docker run -e ...`, or anything else not going through
# Compose's secrets — lib/dockerSecret.js checks a Docker-secret file first, then falls back to
# these plain env vars.
#
# There is no real secrets-management story beyond this file (or docker-secrets/) today (no
# vault, no rotation, no per-environment separation) — fine for a single-operator self-hosted
# deployment, a real gap for anything beyond that. See README.md's "Secrets management" section.

# Monolith's own JWT signing secret — used to sign/verify every auth token.
JWT_SECRET=

# Shared secret between the monolith and services/document-distribution — both sides must have
# the EXACT same value, or every internal call between them gets a 401.
DISTRIBUTION_SERVICE_SECRET=

# Shared secret between the monolith and services/pdf-render — same requirement as above.
PDF_RENDER_SERVICE_SECRET=

# Optional. Raises the login-attempt rate limit (routes/auth.js) above its real-world default
# of 20 per 15 minutes per IP — only meant for CI and other automated-test contexts that log in
# many times in quick succession from one IP. Leave unset for any real deployment.
# LOGIN_RATE_MAX=

# Optional. Overrides services/pdf-render's browser-executable auto-detection (a short list of
# well-known install paths per OS) if Chromium/Chrome/Edge is installed somewhere else.
# PDF_BROWSER_PATH=
