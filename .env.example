# Copy to .env and fill in real values before deploying. Every one of these has an insecure
# dev-default fallback baked into the code (so local `npm run dev` works with zero setup) —
# each fallback logs a console warning naming itself, deliberately, so it's impossible to miss
# in server logs if a real deployment is accidentally still running on the dev defaults.
#
# Running via `docker compose` (docker-compose.yml)? The 4 secrets below are set via
# docker-secrets/*.txt files instead (Compose's native file-based secrets mechanism — see
# docker-compose.yml's own header comment) and don't need to be in this file at all. Set them
# here only for `npm run dev`, a bare `docker run -e ...`, or anything else not going through
# Compose's secrets — lib/dockerSecret.js checks a Docker-secret file first, then falls back to
# these plain env vars.
#
# There is no real secrets-management story beyond this file (or docker-secrets/) today (no
# vault, no rotation, no per-environment separation) — fine for a single-operator self-hosted
# deployment, a real gap for anything beyond that. See README.md's "Secrets management" section.
#
# DATABASE_URL appears once per migrated service below (ARCHITECTURE.md §13, Postgres migration)
# — each is that ONE service's own connection string, scoped to its own database, not a single
# shared value. This file lists them together for reference only; each is meant to be set in
# whatever environment actually runs that specific service's own process (its own container in
# docker-compose.yml, already scoped correctly there) — never source this whole file into one
# shared shell and run multiple of these services from it, or they'll all pick up whichever
# DATABASE_URL happened to be set last.

# Monolith's own JWT signing secret — used to sign/verify every auth token.
JWT_SECRET=

# Shared secret between the monolith and services/document-distribution — both sides must have
# the EXACT same value, or every internal call between them gets a 401.
DISTRIBUTION_SERVICE_SECRET=

# services/document-distribution's own Postgres connection string (ARCHITECTURE.md §13, Postgres
# migration Phase 0 — the first of CargoDesk's services migrated off SQLite). Left unset, the
# service falls back to an embedded @electric-sql/pglite instance (zero setup, fine for local
# dev, not durable/concurrent enough for real deployment). Set to a real Postgres instance before
# deploying this service for real: postgres://user:password@host:5432/database
# DATABASE_URL=

# Shared secret between the monolith and services/pdf-render — same requirement as above.
PDF_RENDER_SERVICE_SECRET=

# Shared secret between the monolith and services/contract-management — same requirement as
# above. Only actually used once app_settings.contract_source is switched to 'remote'
# (Application Settings → API Controls → External APIs) — harmless to leave on the dev default
# otherwise, same as the other two service secrets in a dev environment.
CONTRACT_SERVICE_SECRET=

# Shared secret between the monolith and services/mdm — same requirement as above. Only actually
# used once app_settings.mdm_source is switched to 'remote'.
MDM_SERVICE_SECRET=

# Shared secret between the monolith and services/screening — same requirement as above. Only
# actually used once app_settings.screening_source is switched to 'remote'.
SCREENING_SERVICE_SECRET=

# services/screening's own Postgres connection string (ARCHITECTURE.md §13, Postgres migration
# Phase 1). Left unset, falls back to an embedded @electric-sql/pglite instance (fine for local
# dev, not durable/concurrent enough for real deployment). postgres://user:password@host:5432/database
# DATABASE_URL=

# Shared secret between the monolith and services/kanban — same requirement as above. Only
# actually used once app_settings.kanban_source is switched to 'remote'.
KANBAN_SERVICE_SECRET=

# Shared secret between the monolith and services/customers — same requirement as above. Only
# actually used once app_settings.customer_source is switched to 'remote'.
CUSTOMER_SERVICE_SECRET=

# Optional. Overrides the generic default admin account (admin@cargodesk.com / admin123) that
# seedAdmin() creates on first boot if no users exist yet. Only takes effect on a genuinely fresh
# database — an already-seeded install keeps its existing admin account regardless.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional. Raises the login-attempt rate limit (routes/auth.js) above its real-world default
# of 20 per 15 minutes per IP — only meant for CI and other automated-test contexts that log in
# many times in quick succession from one IP. Leave unset for any real deployment.
# LOGIN_RATE_MAX=

# Optional rate-limit overrides (lib/rateLimit.js) — every one of these has a real, secure
# default baked in (see the comment next to each limiter's own createRateLimiter call for the
# exact number and window) and only needs setting for CI/automated-test contexts that legitimately
# exceed the default from one IP or one account in a single continuous run. Leave all unset for
# any real deployment.
# FORGOT_PW_MAX=
# RESET_PW_MAX=
# SSO_RATE_MAX=
# MAIL_TEST_RATE_MAX=
# AI_CHAT_RATE_MAX=
# SANCTIONS_RATE_MAX=
# DOC_ACTION_RATE_MAX=
# DIST_SEND_RATE_MAX=
# WEBHOOK_TEST_RATE_MAX=
# EXPORT_RATE_MAX=

# Optional. Caps on the /ws endpoint (server.js) — concurrent connections allowed from one IP,
# and messages allowed per connection per 10s window. Real, secure defaults baked in; only meant
# for CI/load-test contexts that legitimately need more.
# WS_MAX_CONN_PER_IP=
# WS_MSG_RATE_MAX=

# Optional. Overrides services/pdf-render's browser-executable auto-detection (a short list of
# well-known install paths per OS) if Chromium/Chrome/Edge is installed somewhere else.
# PDF_BROWSER_PATH=
